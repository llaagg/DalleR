@namespace DalleR.Controls
@using DalleR.Models
@using Revuo.Chat.Abstraction.Base

@inherits Revuo.Chat.Client.Base.Abstractions.BasePayloadControlThinClient<GalleryListPayload, DalleRApp>

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-4 gap-3">
        <button class="btn btn-outline-secondary" @onclick="GoToDashboard">← @(Application?.Translator?["DalleR.Back"] ?? "Back")</button>
        <h2 class="mb-0" style="font-weight:600;">@(Application?.Translator?["DalleR.Galleries"] ?? "Galleries")</h2>
    </div>

    @if (creatingGallery)
    {
        <div class="card mb-3" style="max-width:500px;">
            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label">@(Application?.Translator?["DalleR.GalleryName"] ?? "Name")</label>
                    <input class="form-control" @bind="newGalleryName" />
                </div>
                <div class="mb-2">
                    <label class="form-label">@(Application?.Translator?["DalleR.GalleryDescription"] ?? "Description")</label>
                    <input class="form-control" @bind="newGalleryDescription" />
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="ConfirmCreateGallery">@(Application?.Translator?["DalleR.Create"] ?? "Create")</button>
                    <button class="btn btn-outline-secondary" @onclick="() => creatingGallery = false">@(Application?.Translator?["DalleR.Cancel"] ?? "Cancel")</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <button class="btn btn-success mb-3" @onclick="() => creatingGallery = true">
            + @(Application?.Translator?["DalleR.CreateGallery"] ?? "Create Gallery")
        </button>
    }

    @if (Payload?.D != null && Payload.D.Count > 0)
    {
        <div class="row g-3">
            @foreach (var gallery in Payload.D)
            {
                <div class="col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@gallery.Name</h5>
                            <p class="card-text text-muted small">@gallery.Description</p>
                            <div class="text-muted small mb-3">@gallery.PictureIds.Count @(Application?.Translator?["DalleR.Pictures"] ?? "pictures")</div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-primary" @onclick="() => OpenGallery(gallery.Id!)">
                                    @(Application?.Translator?["DalleR.Open"] ?? "Open")
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteGallery(gallery.Id!)">
                                    🗑
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-muted">@(Application?.Translator?["DalleR.NoGalleries"] ?? "No galleries yet. Create one to organize your pictures.")</div>
    }
</div>
