@namespace DalleR.Controls
@using DalleR.Models
@using Revuo.Chat.Abstraction.Base

@inherits Revuo.Chat.Client.Base.Abstractions.BasePayloadControlThinClient<DashboardPayload, DalleRApp>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h2 style="font-weight:600;">@(Application?.Translator?["DalleR.Dashboard"] ?? "Dashboard")</h2>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div style="font-size:2.5rem;font-weight:700;color:#0d6efd;">@(Payload?.TotalPictures ?? 0)</div>
                    <div class="text-muted">@(Application?.Translator?["DalleR.Pictures"] ?? "Pictures")</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div style="font-size:2.5rem;font-weight:700;color:#198754;">@(Payload?.TotalFolders ?? 0)</div>
                    <div class="text-muted">@(Application?.Translator?["DalleR.Folders"] ?? "Folders")</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div style="font-size:2.5rem;font-weight:700;color:#6f42c1;">@(Payload?.TotalGalleries ?? 0)</div>
                    <div class="text-muted">@(Application?.Translator?["DalleR.Galleries"] ?? "Galleries")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-auto">
            <button class="btn btn-primary btn-lg" @onclick="GoToFolders">
                📁 @(Application?.Translator?["DalleR.ManageFolders"] ?? "Manage Folders")
            </button>
        </div>
        <div class="col-auto">
            <button class="btn btn-success btn-lg" @onclick="GoToGalleries">
                🖼 @(Application?.Translator?["DalleR.ManageGalleries"] ?? "Manage Galleries")
            </button>
        </div>
        <div class="col-auto">
            <button class="btn btn-secondary btn-lg" @onclick="GoToSearch">
                🔍 @(Application?.Translator?["DalleR.Search"] ?? "Search")
            </button>
        </div>
    </div>
</div>
